{
  "name": "ameer-gift",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,css}\" \"tests/**/*.js\" \"tools/**/*.mjs\"",
    "test:e2e": "playwright test",
    "avatars": "node tools/build-avatars.mjs",
    "logo": "node tools/make-logo.mjs",
    "test:rules": "firebase emulators:exec --project demo-ameer-gift --only firestore,database \"node --test tests/rules/rules.test.mjs\"",
    "test:emu": "firebase emulators:exec --project demo-ameer-gift --only auth,firestore \"playwright test -c playwright.emu.config.js\""
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.13.0",
    "firebase-tools": "^15.34.1",
    "globals": "^17.13.0",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "vite": "^8.3.5"
  }
}
